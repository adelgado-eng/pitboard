<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permite que WorkManager reprograme el refresco periódico tras reiniciar el móvil -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Obligatorio pedirlo en tiempo de ejecución desde Android 13 (API 33) — se pide
         al abrir la app por primera vez (NotificationPermissionOnboarding.kt) y, si
         entonces se rechazó, otra vez al activar el interruptor en SettingsScreen.kt -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Clasificaciones (Fase 0): la app pasa a necesitar red por primera vez, solo para
         esta sección — el resto sigue siendo 100% offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PitBoardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PitBoard">

        <!-- Pantalla principal: eventos (calendario automático por serie), clasificaciones, ajustes -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PitBoard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Se abre al arrastrar CUALQUIERA de los widgets al home.
             CORREGIDO: exported="true" — el lanzador de Samsung (una app distinta a la
             nuestra) es quien la invoca desde fuera de nuestro proceso, así que necesita
             exported="true" para poder abrirla. Con "false" el sistema denegaba el intent,
             la config nunca se guardaba, y por eso el widget se veía "sin eventos" aunque
             tuvieras calendarios importados: activeCategories se quedaba vacío. -->
        <activity
            android:name=".widget.RaceWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.PitBoard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.StandingsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.PitBoard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 04/09/2026: un único receiver por widget (antes había 3 para Eventos, uno por
             tamaño preset) — desde Android 12 un solo AppWidgetProviderInfo ya declara un
             rango de tamaño redimensionable a mano (ver race_widget_info.xml). exported="false"
             aquí SÍ es correcto: el sistema entrega estos broadcasts a los proveedores de
             widgets sin necesitar exported="true" (a diferencia de las activities de arriba). -->

        <receiver
            android:name=".widget.RaceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/race_widget_info" />
        </receiver>

        <!-- Widget de Clasificación: un único tipo, configurable por instancia (categoría +
             pilotos/equipos, o clase de coche en WEC/ELMS/IMSA/Le Mans Cup) — se pueden
             colocar varias copias, cada una con su propia configuración, en vez de tener un
             tipo de widget por cada una de las 15 categorías. -->
        <receiver
            android:name=".widget.StandingsWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/standings_widget_info" />
        </receiver>

    </application>

</manifest>